projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_TMG_REJECT_HDR
  alias RejectHdr
{
  use create;
  use update;
  use delete;

  use action ProcessExcel;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Items
  {
    create;
    with draft;
  }
}

define behavior for ZC_TMG_REJECT_CODE
  alias RejectItem
{
  use update;
  use delete;

  use association _Header
  {
    with draft;
  }
}